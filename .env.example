# Phase 2 Compose configuration. Prefer: python scripts/generate_dev_env.py
# Blank secrets must be generated, not copied literally into production.
APP_ENV=development
PUBLIC_WEB_URL=http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=false
# Independent signing secrets: 48+ random characters each. Tenant API never gets platform secret.
JWT_SECRET=
PLATFORM_JWT_SECRET=
# URL-safe base64 of exactly 32 random bytes (Fernet).
FIELD_ENCRYPTION_KEY=
# Use URL-safe passwords so Compose URLs need no extra percent encoding.
POSTGRES_PASSWORD=
OPERATIONS_DB_PASSWORD=
API_DB_PASSWORD=
CONTROL_DB_PASSWORD=
MAIL_DB_PASSWORD=
# Local Mailpit captures invitations/resets and does NOT deliver them externally.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_USERNAME=
SMTP_PASSWORD=
# Production: HTTPS public URL, explicit hosts, COOKIE_SECURE=true,
# APP_ENV=production and real SMTP with SMTP_STARTTLS=true.
# For direct Python execution (Compose derives these; never pass migration URL to runtime API):
# DATABASE_URL=postgresql+psycopg://crm_api:URL_SAFE_PASSWORD@localhost:5432/telite
# CONTROL_DATABASE_URL=postgresql+psycopg://crm_control:URL_SAFE_PASSWORD@localhost:5432/telite
# MAIL_DATABASE_URL=postgresql+psycopg://crm_mail:URL_SAFE_PASSWORD@localhost:5432/telite
# MIGRATION_DATABASE_URL=postgresql+psycopg://migrator:URL_SAFE_PASSWORD@localhost:5432/telite
# ACCESS_TOKEN_TTL_SECONDS=600
# REFRESH_TOKEN_TTL_SECONDS=1209600

# OPERATIONS_DATABASE_URL=postgresql+psycopg://crm_operations:URL_SAFE_PASSWORD@localhost:5432/telite
