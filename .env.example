# Phase 1 configuration contract only. No runnable application yet.
# Blank credentials are deliberate. Production startup must reject blanks/dev values.
APP_ENV=development
APP_NAME=Telite CRM
PUBLIC_WEB_URL=https://crm.example.com
PUBLIC_API_URL=https://crm.example.com/api/v1
ALLOWED_HOSTS=crm.example.com
CORS_ALLOWED_ORIGINS=https://crm.example.com,https://localhost
DEFAULT_TENANT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
# Separate non-owner runtime roles. Inject URLs from secret manager.
DATABASE_URL=
CONTROL_DATABASE_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=
JWT_ISSUER=https://crm.example.com
JWT_TENANT_AUDIENCE=telite-crm-api
JWT_PLATFORM_AUDIENCE=telite-crm-platform
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY_FILE=
JWT_ACTIVE_KEY_ID=
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=true
CSRF_SECRET=
FIELD_ENCRYPTION_KEY_FILE=
# App/workflow limits; validation must bound values at startup.
GPS_MAX_AGE_SECONDS=60
GPS_MAX_ACCURACY_METERS=50
OFFLINE_MAX_AGE_DAYS=7
IDEMPOTENCY_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=120
REPORT_MAX_RANGE_DAYS=366
REPORT_ATTACHMENT_MAX_BYTES=10485760
# Private object store: no public bucket URLs or embedded credentials in client.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_SCANNER_ENDPOINT=
# Optional geocoding, SMS for customer OTP; allowlisted provider adapters only.
GEOCODER_PROVIDER=
GEOCODER_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Telite CRM
REPORT_LOCAL_TIME=08:00
LOCATION_RETENTION_DAYS=90
MEDIA_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=365
BACKUP_RETENTION_DAYS=30
# Secret backup destination/credentials belong only to backup role/service.
BACKUP_DESTINATION=
BACKUP_ENCRYPTION_KEY_FILE=
# Public frontend build settings only. Never prefix secrets with VITE_.
VITE_API_BASE_URL=https://crm.example.com/api/v1
VITE_ANDROID_APP_ID=com.telitesystems.crm
VITE_BACKGROUND_LOCATION_ENABLED=false
